# Copy to .env and fill in your values. NEVER commit .env with real values.

# Google Cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Firebase (client-side — safe to expose, but use placeholders here)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Gateway
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# ADK agents backend (Cloud Run). Server-side only — read by the Next.js route
# handlers in frontend/app/api/v1/* that proxy to the deployed ADK service.
AGENTS_SERVICE_URL=https://ecopulse-agents-xxxxxxxx-uc.a.run.app
AGENTS_APP_NAME=ecopulse_agents
# Set to "true" to bypass MSW mocks and use the live ADK backend in dev.
NEXT_PUBLIC_USE_LIVE_BACKEND=false

# Python services (all real values fetched from Secret Manager at runtime)
# These are used by docker-compose for local dev only
FIREBASE_SERVICE_ACCOUNT_PATH=  # leave empty — Secret Manager is used in production
REDIS_URL=redis://redis:6379

# Local Firestore emulator
FIRESTORE_EMULATOR_HOST=firestore:8080
